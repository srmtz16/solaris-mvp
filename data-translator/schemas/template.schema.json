{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SOLARIS Data Translator Mapping Template",
  "type": "object",
  "required": [
    "templateId",
    "name",
    "manufacturer",
    "model",
    "fileType",
    "sheetName",
    "headerRow",
    "dateFormat",
    "timezone",
    "version",
    "confidence",
    "formatSignature",
    "mappings"
  ],
  "properties": {
    "templateId": { "type": "string" },
    "name": { "type": "string" },
    "manufacturer": { "type": "string" },
    "model": { "type": "string" },
    "fileType": { "enum": ["csv", "xls", "xlsx"] },
    "sheetName": { "type": "string" },
    "headerRow": { "type": "integer", "minimum": 1 },
    "dateFormat": { "type": "string" },
    "timezone": { "type": "string" },
    "version": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "formatSignature": { "type": "string" },
    "scope": { "enum": ["official", "private", "custom"] },
    "exportType": { "type": "string" },
    "anonymizedSample": { "type": "object" },
    "parameterizedRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "manufacturer",
          "sourcePattern",
          "displayPattern",
          "targetField",
          "family",
          "indexCaptureGroup",
          "detectedUnit",
          "standardUnit",
          "conversion",
          "importance",
          "status",
          "scope",
          "createdBy",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "manufacturer": { "type": "string" },
          "modelScope": { "type": ["string", "null"] },
          "sourcePattern": { "type": "string" },
          "displayPattern": { "type": "string" },
          "targetField": { "type": "string" },
          "family": { "type": "string" },
          "electricalSide": { "enum": ["dc", "ac", "grid", "none"] },
          "entity": { "type": "string" },
          "indexCaptureGroup": { "type": "integer" },
          "detectedUnit": { "type": "string" },
          "standardUnit": { "type": "string" },
          "conversion": { "type": "string" },
          "importance": { "enum": ["critical", "important", "complementary", "optional", "ignore"] },
          "measurementType": { "type": "string" },
          "status": { "enum": ["draft", "validated", "suggested"] },
          "scope": { "enum": ["current_file", "manufacturer", "manufacturer_model", "global"] },
          "createdBy": { "enum": ["system", "user", "ai"] },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" }
        }
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceHeader",
          "normalizedSourceHeader",
          "targetField",
          "sourceUnit",
          "targetUnit",
          "transform",
          "required",
          "confidence"
        ],
        "properties": {
          "sourceHeader": { "type": "string" },
          "normalizedSourceHeader": { "type": "string" },
          "targetField": { "type": "string" },
          "sourceUnit": { "type": "string" },
          "targetUnit": { "type": "string" },
          "transform": { "type": "string" },
          "required": { "type": "boolean" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "semantic": {
            "type": "object",
            "required": [
              "sourceHeader",
              "normalizedHeader",
              "displayName",
              "fieldId",
              "family",
              "transform",
              "priority",
              "confidence",
              "required",
              "uses",
              "status"
            ],
            "properties": {
              "sourceHeader": { "type": "string" },
              "normalizedHeader": { "type": "string" },
              "displayName": { "type": "string" },
              "fieldId": { "type": "string" },
              "family": {
                "enum": [
                  "identification",
                  "energy",
                  "power",
                  "voltage",
                  "current",
                  "power_quality",
                  "environment",
                  "operation",
                  "unknown"
                ]
              },
              "category": { "type": "string" },
              "electricalSide": { "enum": ["dc", "ac", "grid", "none"] },
              "entity": { "type": "string" },
              "measurementType": { "type": "string" },
              "index": { "type": "integer" },
              "phase": { "type": "string" },
              "phaseFrom": { "type": "string" },
              "phaseTo": { "type": "string" },
              "sourceUnit": { "type": "string" },
              "standardUnit": { "type": "string" },
              "transform": { "type": "string" },
              "priority": { "enum": ["critical", "important", "complementary", "optional", "ignore"] },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "required": { "type": "boolean" },
              "uses": { "type": "array", "items": { "type": "string" } },
              "description": { "type": "string" },
              "patternId": { "type": "string" },
              "status": { "enum": ["auto_detected", "needs_review", "confirmed", "unassigned", "ignored"] }
            }
          }
        }
      }
    }
  }
}
